// use prisma-next

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  rut       String   @unique
  email     String
  phone     String?
  logoUrl   String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  users     User[]
  customers Customer[]
  locations Location[]
  workers   Worker[]
  serviceTypes ServiceType[]
  scheduledServices ScheduledService[]
  documents Document[]
}





model User {
  id           Int                @id @default(autoincrement())
  tenantId     Int
  email        String
  passwordHash String
  role         String
  active       Boolean            @default(true)
  createdAt    TimestamptzString  @default(now())
  updatedAt    temporal.updatedAtString()

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  worker       Worker?
}


model Customer {
  id                Int                @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  locations         Location[]
  scheduledServices ScheduledService[]
  name              String
  rut               String?
  email             String?
  phone             String?
  active            Boolean            @default(true)
  createdAt         TimestamptzString   @default(now())
  updatedAt         temporal.updatedAtString()
}


model Location {
  id                Int                @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  customerId        Int
  customer          Customer            @relation(fields: [customerId], references: [id])
  name              String
  address           String
  commune           String?
  contactName       String?
  contactPhone      String?
  instructions      String?
  latitude          Float?
  longitude         Float?
  active            Boolean            @default(true)
  createdAt         TimestamptzString  @default(now())
  updatedAt         temporal.updatedAtString()

  scheduledServices ScheduledService[]
}


model Worker {
  id                Int                @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  userId            Int?               @unique
  user              User?              @relation(fields: [userId], references: [id])
  name              String
  rut               String
  phone             String?
  email             String?
  position          String?
  active            Boolean            @default(true)
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  scheduledServices ScheduledService[]
}

model ServiceType {
  id                Int                @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  name              String
  description       String?
  estimatedMinutes  Int?
  active            Boolean            @default(true)
  createdAt         TimestamptzString  @default(now())
  updatedAt         temporal.updatedAtString()

  checklistItems    ChecklistItem[]
  scheduledServices ScheduledService[]
}



model ChecklistItem {
  id                Int                @id @default(autoincrement())
  serviceTypeId     Int
  serviceType       ServiceType        @relation(fields: [serviceTypeId], references: [id])
  label             String
  type              String
  required          Boolean            @default(false)
  sortOrder         Int
  requiresPhoto     Boolean            @default(false)
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  checklistAnswers  ChecklistAnswer[]
}


model ScheduledService {
  id            Int                @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  customerId    Int
  customer      Customer           @relation(fields: [customerId], references: [id])
  locationId    Int
  location      Location           @relation(fields: [locationId], references: [id])
  serviceTypeId Int
  serviceType   ServiceType        @relation(fields: [serviceTypeId], references: [id])
  workerId      Int?
  worker        Worker?            @relation(fields: [workerId], references: [id])
  scheduledDate String
  startTime     String?
  endTime       String?
  status        String
  startedAt     TimestamptzString?
  completedAt   TimestamptzString?
  createdAt     TimestamptzString  @default(now())
  updatedAt     temporal.updatedAtString()

  checklistAnswers ChecklistAnswer[]
  evidences        Evidence[]
  observations     ServiceObservation[]
  reports          Report[]
}




model ChecklistAnswer {
  id                 Int                @id @default(autoincrement())
  scheduledServiceId Int
  scheduledService   ScheduledService   @relation(fields: [scheduledServiceId], references: [id])
  checklistItemId    Int
  checklistItem      ChecklistItem @relation(fields: [checklistItemId], references: [id])
  value              String?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
}

model Evidence {
  id                 Int               @id @default(autoincrement())
  scheduledServiceId Int
  scheduledService   ScheduledService  @relation(fields: [scheduledServiceId], references: [id])
  type               String
  fileUrl            String
  description        String?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
}
model ServiceObservation {
  id                 Int               @id @default(autoincrement())
  scheduledServiceId Int
  scheduledService   ScheduledService  @relation(fields: [scheduledServiceId], references: [id])
  text               String
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
}



model Report {
  id                 Int               @id @default(autoincrement())
  scheduledServiceId Int
  scheduledService   ScheduledService  @relation(fields: [scheduledServiceId], references: [id])
  fileUrl            String
  generatedAt        TimestamptzString @default(now())
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
}
model Document {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  workerId  Int
  name      String
  type      String
  fileUrl   String
  issuedAt  TimestamptzString?
  expiresAt TimestamptzString?
  status    String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}




model AuditLog {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  metadata  String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}












