// use prisma-next

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  rut       String   @unique
  email     String
  phone     String?
  logoUrl   String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model User {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  email        String
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}
model Customer {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String
  rut       String?
  email     String?
  phone     String?
  active    Boolean  @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
model Location {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  customerId   Int
  name         String
  address      String
  commune      String?
  contactName  String?
  contactPhone String?
  instructions String?
  latitude     Float?
  longitude    Float?
  active       Boolean  @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}
model Worker {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String
  rut       String
  phone     String?
  email     String?
  position  String?
  active    Boolean  @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
model ServiceType {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  name            String
  description     String?
  estimatedMinutes Int?
  active          Boolean  @default(true)
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}
model ChecklistItem {
  id             Int      @id @default(autoincrement())
  serviceTypeId  Int
  label          String
  type           String
  required       Boolean  @default(false)
  sortOrder      Int
  requiresPhoto  Boolean  @default(false)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}
model ScheduledService {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  customerId    Int
  locationId    Int
  serviceTypeId Int
  workerId      Int?
  scheduledDate String
  startTime     String?
  endTime       String?
  status        String
  startedAt     TimestamptzString?
  completedAt   TimestamptzString?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}
model ChecklistAnswer {
  id                 Int      @id @default(autoincrement())
  scheduledServiceId Int
  checklistItemId    Int
  value              String?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
}







