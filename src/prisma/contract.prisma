// use prisma-next

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  rut       String   @unique
  email     String
  phone     String?
  logoUrl   String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model User {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  email        String
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}
model Customer {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  name      String
  rut       String?
  email     String?
  phone     String?
  active    Boolean  @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
model Location {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  customerId   Int
  name         String
  address      String
  commune      String?
  contactName  String?
  contactPhone String?
  instructions String?
  latitude     Float?
  longitude    Float?
  active       Boolean  @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

